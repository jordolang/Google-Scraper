# Copy to .env and fill in real values. .env is gitignored.
#
# jlang.dev is an iCloud Custom Email Domain. iCloud's SMTP server
# (smtp.mail.me.com:587, STARTTLS) requires authenticating as the Apple ID
# that owns the domain — NOT the custom-domain alias. Using the alias as the
# login returns "535 5.7.8 Error: authentication failed". The alias is still
# what appears in the From: header.
#
# EMAIL_PASSWORD must be an app-specific password from appleid.apple.com
# (Sign-In and Security -> App-Specific Passwords), not the Apple ID password.
# Hyphens are optional; send_emails.py strips them before login.
SMTP_USERNAME=your-apple-id@icloud.com
EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
